# Shopify Storefront API Configuration (API Version: 2026-07)
# Dominio myshopify de tu tienda (ej: mi-tienda.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=

# Token de acceso público de Storefront API (Headless Storefront)
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Versión de la Storefront API
VITE_SHOPIFY_API_VERSION=2026-07

# Handle del producto LISO en Shopify
VITE_SHOPIFY_PRODUCT_HANDLE=plancha-de-vapor-portatil-liso
